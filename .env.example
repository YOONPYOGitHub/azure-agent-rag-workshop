# 강사가 배포한 APIM 주소 + 개인 구독 키를 입력합니다. 실제 키는 Git에 올리지 마세요.
OPENAI_BASE_URL=https://YOUR-APIM.azure-api.net/agent-rag/openai/v1
WORKSHOP_API_KEY=REPLACE_WITH_YOUR_PERSONAL_KEY
AZURE_SEARCH_ENDPOINT=https://YOUR-APIM.azure-api.net/agent-rag/search
AZURE_SEARCH_INDEX=student01
OPENAI_MODEL=gpt-5.6-terra
# 임베딩은 text-embedding-3-small, 1536차원으로 고정됩니다.
AZURE_SEARCH_SEMANTIC=false
